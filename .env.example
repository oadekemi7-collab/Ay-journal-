# ==============================================================================
# JOURNALY PRODUCTION CONFIGURATION (.env)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. TRANSACTIONAL EMAIL DELIVERY (Required for Password Reset Emails in Production)
# ------------------------------------------------------------------------------
# Option A: RESEND (RECOMMENDED for Render / Production)
# Sign up free at https://resend.com (3,000 free emails/month)
# Provides 100% reliable HTTPS REST delivery without SMTP port blocks.
RESEND_API_KEY=
RESEND_FROM=Journaly <onboarding@resend.dev>

# Option B: BREVO (Formerly Sendinblue)
# Free 300 emails/day at https://brevo.com
BREVO_API_KEY=
BREVO_FROM=security@yourdomain.com

# Option C: SENDGRID
# Free 100 emails/day at https://sendgrid.com
SENDGRID_API_KEY=
SENDGRID_FROM=security@yourdomain.com

# Option D: CUSTOM SMTP (Google Workspace, Postmark, AWS SES, Mailgun, etc.)
# If using Gmail, you MUST use a 16-character Google App Password (not your account password):
# https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=
SMTP_FROM_EMAIL=your_email@gmail.com
SMTP_FROM_NAME=Journaly

# ------------------------------------------------------------------------------
# 2. SESSION SECURITY
# ------------------------------------------------------------------------------
# 32+ character random secret used to sign session tokens:
SESSION_SECRET=

# ------------------------------------------------------------------------------
# 3. FIREBASE CLIENT CONFIGURATION
# ------------------------------------------------------------------------------
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# ------------------------------------------------------------------------------
# 4. METATRADER 5 (MetaApi Cloud SDK)
# ------------------------------------------------------------------------------
METAAPI_API_TOKEN=

# ------------------------------------------------------------------------------
# 5. PAYSTACK SUBSCRIPTION PAYMENTS
# ------------------------------------------------------------------------------
PAYSTACK_SECRET_KEY=
VITE_PAYSTACK_PUBLIC_KEY=
